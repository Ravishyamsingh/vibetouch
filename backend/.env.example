# Copy this file to .env and fill in your real values.

# Full Postgres connection string, e.g.:
# postgresql://username:password@localhost:5432/vibetouch
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibetouch

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# --- Admin dashboard -------------------------------------------------------
# Any long random string — used to sign admin login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Used only once, by `npm run db:seed-admin`, to create your admin login.
# Not stored in plaintext — only the bcrypt hash is saved to the database.
ADMIN_EMAIL=admin@vibetouch.in
ADMIN_PASSWORD=change-this-password
